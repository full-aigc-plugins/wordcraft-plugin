{
  "name": "wordcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "工作周报、会议纪要、商业报价、验收报告、需求说明与简历；样式、目录、页码与图表题注保持一致。",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "WordCraft（文档写作）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "wordcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "WordCraft（文档写作）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "WordCraft (Document Writing)",
          "zh-CN": "WordCraft（文档写作）"
        },
        "icon": "file-text",
        "server": "wordcraft-editor",
        "resourceUri": "ui://wordcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
